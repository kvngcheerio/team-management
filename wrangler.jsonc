{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "matchday",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Better Auth relies on AsyncLocalStorage and node:crypto shims.
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": { "enabled": true },
  "assets": {
    // Client-side routes fall back to index.html.
    "not_found_handling": "single-page-application",
    // API requests always reach the Worker before static assets.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "matchday-db",
      // Replace with the id printed by `wrangler d1 create matchday-db`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Public, non-secret configuration. Secrets go in `wrangler secret put` / .dev.vars.
    "APP_ENV": "production"
  }
}
