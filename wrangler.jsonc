{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "matchday",
	"main": "./src/worker/index.ts",
	"compatibility_date": "2026-10-01",
	// Better Auth relies on AsyncLocalStorage and node:crypto shims.
	"compatibility_flags": [
		"nodejs_compat"
	],
	"upload_source_maps": true,
	"observability": {
		"enabled": true
	},
	"assets": {
		// Client-side routes fall back to index.html.
		"not_found_handling": "single-page-application",
		// API requests always reach the Worker before static assets.
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
    {
      // The code reads env.DB, so the binding name must stay "DB".
      "binding": "DB",
      "database_name": "matchday-db",
      "database_id": "7213dc51-ccc3-45be-bdf3-114401d29ac5",
      "migrations_dir": "migrations"
    }
  ],
	// Daily at 05:00 UTC (06:00 WAT): create scheduled match days and open check-in.
	// Every 15 minutes: email check-in reminders on match day, 2 hours before kick-off.
	"triggers": { "crons": ["0 5 * * *", "*/15 * * * *"] },
	"vars": {
		// Public, non-secret configuration. Secrets go in `wrangler secret put` / .dev.vars.
		"APP_ENV": "production",
		// Extra origins allowed to sign in, besides BETTER_AUTH_URL (the main/custom domain).
		"APP_ORIGINS": "https://matchday.control-f8d.workers.dev",
		// Sender for reminder emails, sent through Resend (RESEND_API_KEY secret); the domain must be verified in Resend.
		"EMAIL_FROM": "Matchday <noreply@pluvialhq.com>"
	}
}