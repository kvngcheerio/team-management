# Copy to .dev.vars for local development. Never commit real secrets.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string
# Public URL of the app. Local dev server default:
BETTER_AUTH_URL=http://localhost:5173
# One-time token required to create the first admin at /setup.
SETUP_TOKEN=replace-with-a-random-token
APP_ENV=development
